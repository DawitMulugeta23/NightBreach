import React, { useState, useEffect, useRef, useLayoutEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import toast from 'react-hot-toast'
import { learningApi, tokenStorage } from '../utils/api'
import { useAuth } from '../context/AuthContext'
import LoadingSpinner from '../components/LoadingSpinner'

function pickIcon(slug = '') {
  if (slug.includes('linux')) return 'fa-terminal'
  if (slug.includes('network')) return 'fa-network-wired'
  if (slug.includes('cyber') || slug.includes('fundamental')) return 'fa-shield-halved'
  if (slug.includes('defensive')) return 'fa-shield-cat'
  if (slug.includes('offensive')) return 'fa-crosshairs'
  if (slug.includes('web')) return 'fa-code'
  return 'fa-book'
}

function FoundationCard({ path, onClick, clicking }) {
  return (
    <button
      onClick={onClick}
      disabled={clicking}
      className="group relative rounded-xl p-[1.5px] bg-gradient-to-br from-cyan-400 to-cyan-600 transition-all duration-300 hover:-translate-y-0.5 shadow-[0_0_20px_-8px_rgba(34,211,238,0.6)] disabled:opacity-60 w-full"
    >
      <div className="relative rounded-[10px] bg-neutral-950/95 p-4 h-full text-left">
        <div className="flex items-center gap-2 mb-2">
          <div className="shrink-0 w-9 h-9 rounded-lg flex items-center justify-center bg-cyan-500/15">
            <i className={`fas ${pickIcon(path.slug)} text-sm text-cyan-300`}></i>
          </div>
          <h3 className="font-bold text-sm text-cyan-100 leading-tight">{path.title}</h3>
        </div>
        <p className="text-xs text-neutral-400 leading-snug mb-2 line-clamp-2">{path.description}</p>
        <span className="text-xs font-semibold text-cyan-300 inline-flex items-center gap-1">
          {clicking ? '...' : `${path.room_count} module${path.room_count === 1 ? '' : 's'} — Explore`}
          {!clicking && <i className="fas fa-arrow-right text-[9px]"></i>}
        </span>
      </div>
    </button>
  )
}

const SpecCard = React.forwardRef(({ path, onClick, clicking }, ref) => {
  const isLocked = path.locked
  return (
    <button
      ref={ref}
      onClick={onClick}
      disabled={clicking || isLocked}
      className="group relative rounded-xl p-[1.5px] bg-gradient-to-br from-fuchsia-400 to-fuchsia-600 transition-all duration-300 hover:-translate-y-0.5 shadow-[0_0_20px_-8px_rgba(232,121,249,0.6)] disabled:opacity-70 w-64"
    >
      <div className="relative rounded-[10px] bg-neutral-950/95 p-4 h-full text-left">
        <div className="flex items-center gap-2 mb-2">
          <div className="shrink-0 w-9 h-9 rounded-lg flex items-center justify-center bg-fuchsia-500/15">
            <i className={`fas ${isLocked ? 'fa-lock' : pickIcon(path.slug)} text-sm text-fuchsia-300`}></i>
          </div>
          <h3 className="font-bold text-sm text-fuchsia-100 leading-tight">{path.title}</h3>
        </div>
        <p className="text-xs text-neutral-400 leading-snug mb-2 line-clamp-2">{path.description}</p>
        <span className={`text-xs font-semibold inline-flex items-center gap-1 ${isLocked ? 'text-neutral-500' : 'text-fuchsia-300'}`}>
          {isLocked ? 'Complete Foundations to unlock' : clicking ? '...' : `${path.room_count} module${path.room_count === 1 ? '' : 's'} — Explore`}
          {!isLocked && !clicking && <i className="fas fa-arrow-right text-[9px]"></i>}
        </span>
      </div>
    </button>
  )
})

function DiagramConnectors({ containerRef, startRef, hubRef, specRefs, specCount }) {
  const [svgPaths, setSvgPaths] = useState({ startToHub: '', branches: [] })

  useLayoutEffect(() => {
    function measure() {
      const containerEl = containerRef.current
      const startEl = startRef.current
      const hubEl = hubRef.current
      if (!containerEl || !startEl || !hubEl) return

      const cRect = containerEl.getBoundingClientRect()
      const rel = (rect) => ({
        left: rect.left - cRect.left,
        right: rect.right - cRect.left,
        midY: rect.top - cRect.top + rect.height / 2,
      })

      const s = rel(startEl.getBoundingClientRect())
      const h = rel(hubEl.getBoundingClientRect())
      const startToHub = `M ${s.right} ${s.midY} L ${h.left} ${h.midY}`

      // Right-angle (Manhattan) routing: out from hub, split vertically at
      // the midpoint, then straight into each card — matches the reference
      // diagram's sharp elbow connectors rather than a smooth diagonal curve.
      const branches = []
      specRefs.current.forEach((el) => {
        if (!el) return
        const r = rel(el.getBoundingClientRect())
        const x0 = h.right, y0 = h.midY
        const x1 = r.left, y1 = r.midY
        const midX = x0 + (x1 - x0) * 0.4
        branches.push(`M ${x0} ${y0} L ${midX} ${y0} L ${midX} ${y1} L ${x1} ${y1}`)
      })

      setSvgPaths({ startToHub, branches })
    }

    measure()
    const ro = new ResizeObserver(measure)
    if (containerRef.current) ro.observe(containerRef.current)
    window.addEventListener('resize', measure)
    return () => {
      ro.disconnect()
      window.removeEventListener('resize', measure)
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [specCount])

  return (
    <svg className="pointer-events-none absolute inset-0 w-full h-full" style={{ zIndex: 0 }}>
      <defs>
        <marker id="arrowRed" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#FF4757" />
        </marker>
        <marker id="arrowMagenta" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#FF2E92" />
        </marker>
      </defs>
      {svgPaths.startToHub && (
        <path d={svgPaths.startToHub} stroke="#FF4757" strokeWidth="4" fill="none" markerEnd="url(#arrowRed)" />
      )}
      {svgPaths.branches.map((d, i) => (
        <path key={i} d={d} stroke="#FF2E92" strokeWidth="4" fill="none" strokeLinejoin="round" markerEnd="url(#arrowMagenta)" />
      ))}
    </svg>
  )
}

function LearningPaths() {
  const { isAuthenticated } = useAuth()
  const navigate = useNavigate()
  const [paths, setPaths] = useState([])
  const [loading, setLoading] = useState(false)
  const [clicking, setClicking] = useState(null)

  const containerRef = useRef(null)
  const startRef = useRef(null)
  const hubRef = useRef(null)
  const specRefs = useRef([])
  specRefs.current = []
  const addSpecRef = (el) => {
    if (el && !specRefs.current.includes(el)) specRefs.current.push(el)
  }

  useEffect(() => {
    if (!isAuthenticated) return
    const token = tokenStorage.get()
    if (!token) return
    setLoading(true)
    learningApi
      .listPaths(token)
      .then(setPaths)
      .catch((err) => toast.error(err.message || 'Failed to load learning paths'))
      .finally(() => setLoading(false))
  }, [isAuthenticated])

  const handlePathClick = (path) => {
    if (path.locked) {
      toast('Complete all Foundation paths to unlock this one!', { icon: '🔒' })
      return
    }
    if (!isAuthenticated) {
      toast('Please log in to start learning', { icon: '🔒' })
      return navigate('/login')
    }
    if (!path.room_count) {
      toast('No modules in this path yet. Content coming soon!', { icon: '🚧' })
      return
    }
    setClicking(path.id)
    navigate(`/learning/paths/${path.id}`)
  }

  const foundations = [...paths].filter((p) => p.tier === 'foundations').sort((a, b) => a.order_index - b.order_index)
  const specializations = [...paths].filter((p) => p.tier === 'specializations').sort((a, b) => a.order_index - b.order_index)

  return (
    <div className="relative w-full min-h-screen px-4 sm:px-6 md:px-8 py-10 md:py-14 overflow-x-auto bg-neutral-950 text-neutral-100">
      <div
        className="pointer-events-none fixed inset-0 opacity-[0.15]"
        style={{
          backgroundImage:
            'linear-gradient(rgba(34,211,238,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(34,211,238,0.15) 1px, transparent 1px)',
          backgroundSize: '48px 48px',
        }}
      />

      <div className="text-center mb-14 relative z-10">
        <h1 className="text-3xl md:text-5xl font-extrabold uppercase tracking-wider text-white mb-3">
          Learning <span className="text-cyan-400">Paths</span>
        </h1>
        <p className="text-neutral-400 text-sm md:text-base">
          Master the Foundations, then choose your specialization.
        </p>
      </div>

      {loading && <LoadingSpinner message="Loading paths..." />}

      {!loading && (
        <div ref={containerRef} className="relative min-w-[900px] max-w-7xl mx-auto min-h-[420px]">
          <DiagramConnectors
            containerRef={containerRef}
            startRef={startRef}
            hubRef={hubRef}
            specRefs={specRefs}
            specCount={specializations.length}
          />

          <div className="relative z-10 flex items-center gap-10">
            <div
              ref={startRef}
              className="shrink-0 px-6 py-3 rounded-full border-2 border-cyan-400 text-cyan-300 font-bold text-sm bg-neutral-950/90 shadow-[0_0_20px_-4px_rgba(34,211,238,0.6)]"
            >
              Start
            </div>

            <div
              ref={hubRef}
              className="relative flex-1 rounded-2xl border-2 border-cyan-400/70 bg-neutral-900/40 p-6 shadow-[0_0_30px_-10px_rgba(34,211,238,0.5)]"
            >
              <span className="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 text-xs font-bold uppercase tracking-widest bg-neutral-950 text-cyan-300 border border-cyan-400/60 rounded-full">
                Foundation Hub
              </span>
              <div className="flex flex-col sm:flex-row gap-4 mt-2">
                {foundations.map((path) => (
                  <FoundationCard
                    key={path.id}
                    path={path}
                    clicking={clicking === path.id}
                    onClick={() => handlePathClick(path)}
                  />
                ))}
              </div>
            </div>

            <div className="shrink-0 flex flex-col gap-8">
              {specializations.map((path) => (
                <SpecCard
                  key={path.id}
                  ref={addSpecRef}
                  path={path}
                  clicking={clicking === path.id}
                  onClick={() => handlePathClick(path)}
                />
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

export default LearningPaths
