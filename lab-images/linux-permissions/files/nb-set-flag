#!/bin/sh
# Root-only helper used by NightBreach to plant the per-lab flag.
set -eu
[ "$(id -u)" = 0 ] || { echo "root only" >&2; exit 1; }
printf '%s' "${1:-}" | grep -Eq '^NB\{[A-Za-z0-9_-]{8,64}\}$' \
  || { echo "invalid flag format" >&2; exit 1; }
sed -i "s|^-- lab-flag: .*|-- lab-flag: $1|" /srv/backups/db-backup.sql
